<UserControl x:Class="grzyClothTool.Controls.PreviewWindowHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:grzyClothTool.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource Brush50}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Preview toolbar (kept outside the 3D surface so nothing overlaps it) -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="KeepOutfitCheck"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="12.5"
                          ToolTip="Build an outfit: selecting a drawable only replaces items in the same slot, everything else stays on the ped."
                          Checked="KeepOutfit_Changed"
                          Unchecked="KeepOutfit_Changed">
                    <TextBlock Text="Keep outfit" Margin="2,0,0,0" />
                </CheckBox>
                <Button Style="{StaticResource GhostButton}"
                        Padding="10,3"
                        Margin="12,0,0,0"
                        FontSize="12"
                        ToolTip="Remove everything except the current selection"
                        Click="ClearOutfit_Click"
                        Content="Clear outfit" />
            </StackPanel>
        </Border>

        <WindowsFormsHost x:Name="PreviewHost" Grid.Row="1" Background="Black" />
        <TextBlock x:Name="PlaceholderText" Grid.Row="1" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
