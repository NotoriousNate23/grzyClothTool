<UserControl x:Class="grzyClothTool.Controls.CustomButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:grzyClothTool.Controls"
             xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             x:Name="MyCustomButton"
             MinHeight="32"
             d:Height="36" d:Width="200"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Visual variants: Secondary (default), Primary, Ghost, Danger -->
        <Style TargetType="Button" x:Key="VariantButton">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{Binding CornerRadius, ElementName=MyCustomButton}" />
                            <Border x:Name="Overlay"
                                    Background="{DynamicResource TextPrimaryBrush}"
                                    CornerRadius="{Binding CornerRadius, ElementName=MyCustomButton}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="12,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.07" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Variant, ElementName=MyCustomButton}" Value="Primary">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Variant, ElementName=MyCustomButton}" Value="Ghost">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Variant, ElementName=MyCustomButton}" Value="Danger">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="IconAndLabelTemplate">
            <StackPanel Orientation="Horizontal">
                <icons:MaterialIcon Kind="{Binding Image, ElementName=MyCustomButton}"
                                    Width="{Binding IconSize, ElementName=MyCustomButton}"
                                    Height="{Binding IconSize, ElementName=MyCustomButton}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,7,0" />
                <TextBlock Text="{Binding Label, ElementName=MyCustomButton}"
                           VerticalAlignment="Center"
                           FontWeight="{Binding FontWeight, ElementName=MyCustomButton}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="IconOnlyTemplate">
            <icons:MaterialIcon Kind="{Binding Image, ElementName=MyCustomButton}"
                                Width="{Binding IconSize, ElementName=MyCustomButton}"
                                Height="{Binding IconSize, ElementName=MyCustomButton}" />
        </DataTemplate>

        <DataTemplate x:Key="LabelOnlyTemplate">
            <TextBlock Text="{Binding Label, ElementName=MyCustomButton}"
                       VerticalAlignment="Center"
                       FontWeight="{Binding FontWeight, ElementName=MyCustomButton}" />
        </DataTemplate>

        <Style x:Key="DropdownToggleStyle" TargetType="ToggleButton">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Background="Transparent">
                            <Border Width="1" HorizontalAlignment="Left" Margin="0,8" Background="{DynamicResource ControlBorderBrush}" />
                            <Border x:Name="Hover" Background="{DynamicResource TextPrimaryBrush}" Opacity="0" CornerRadius="{Binding CornerRadius, ElementName=MyCustomButton}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.07" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DropdownEnabled, ElementName=MyCustomButton}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="btn">
            <Button x:Name="InnerButton"
                    AutomationProperties.Name="{Binding Label, ElementName=MyCustomButton}"
                    AutomationProperties.AutomationId="{Binding (AutomationProperties.AutomationId), ElementName=MyCustomButton}"
                    ToolTip="{Binding Tooltip, ElementName=MyCustomButton}"
                    ToolTipService.InitialShowDelay="300"
                    FontSize="{Binding FontSize, ElementName=MyCustomButton}"
                    Click="Button_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource VariantButton}">
                        <Setter Property="ContentTemplate" Value="{StaticResource IconAndLabelTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Image, ElementName=MyCustomButton}" Value="{x:Null}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LabelOnlyTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Label, ElementName=MyCustomButton}" Value="">
                                <Setter Property="ContentTemplate" Value="{StaticResource IconOnlyTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>

        <ToggleButton Style="{StaticResource DropdownToggleStyle}"
                      x:Name="DropdownToggle"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      Width="34"
                      AutomationProperties.Name="More options">
            <Path Data="M 0 0 L 4.5 4.5 L 9 0"
                  Stroke="{Binding Foreground, ElementName=InnerButton}"
                  StrokeThickness="1.6"
                  Width="9"
                  Height="5"
                  Stretch="Fill" />
        </ToggleButton>

        <Popup MinWidth="{Binding ActualWidth, ElementName=btn}"
               PlacementTarget="{Binding ElementName=btn}"
               Placement="Bottom"
               VerticalOffset="2"
               HorizontalOffset="-6"
               StaysOpen="False"
               IsOpen="{Binding IsChecked, ElementName=DropdownToggle}"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Grid Margin="6,2,12,14">
                <Border Style="{StaticResource MenuShadowLayer}" />
                <Border Style="{StaticResource MenuPanelBorder}">
                    <ContentPresenter x:Name="DropdownContentPresenter" />
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
