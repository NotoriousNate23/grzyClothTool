<Window x:Class="grzyClothTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:grzyClothTool.Helpers"
        xmlns:app="clr-namespace:grzyClothTool"
        xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:constants="clr-namespace:grzyClothTool.Constants"
        xmlns:controls="clr-namespace:grzyClothTool.Controls"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        d:DataContext="{d:DesignInstance Type=helpers:NavigationHelper, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Title="Nightfall Clothing" Height="900" Width="1440" MinWidth="1200" MinHeight="780"
        MouseDown="Window_MouseDown"
        Closed="Window_Closed"
        Closing="Window_Closing"
    >

    <Window.Resources>
        <Style x:Key="FooterLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Project tab (browser-style) -->
        <Style x:Key="ProjectTabButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Height="30"
                                Padding="10,0,4,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Width="20" Height="20">
                            <icons:MaterialIcon x:Name="Icon" Kind="Close" Width="12" Height="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuIcon" TargetType="icons:MaterialIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- App bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Height="42"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Image Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/grzyClothTool;component/Resources/grzyClothTool.png" />
                    <TextBlock Text="Nightfall Clothing"
                               Margin="9,0,0,0"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <Menu Grid.Column="1" VerticalAlignment="Center">
                    <MenuItem Header="_Project">
                        <MenuItem Header="_Back to home screen" Click="HomeScreen_Click">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="Home" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="ContentSave" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Open Addon…" Click="OpenAddon_Click"
                                  ToolTip="Open addon files (replaces current project)">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="FolderOpenOutline" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Add Addon…" Click="AddAddon_Click"
                                  ToolTip="Add addon files to current project">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="Plus" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Import Project…" Click="ImportProject_Click">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="FileImportOutline" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Import DurtyCloth _Folder…" Click="ImportDurtyClothFolder_Click"
                                  ToolTip="Scan a DurtyCloth folder and import every project - even without the .dctproj file">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="FolderOutline" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Import _DurtyCloth Project File…" Click="ImportDurtyCloth_Click"
                                  ToolTip="Open .dctproj / .durty-cloth.json files (each opens in its own tab)">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="FileImportOutline" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Remove _Reserved Slots" Click="RemoveReservedSlots_Click"
                                  ToolTip="Delete all reserved (empty placeholder) drawables and renumber">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="TrashCanOutline" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Export Project…" Click="ExportProject_Click">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="Export" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_View" Tag="View">
                        <MenuItem Header="_Logs" Tag="Logs" Click="LogsOpen_Click">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="FormatListBulleted" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Duplicate Inspector" Tag="DuplicateInspector" Click="DuplicateInspector_Click">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="ContentDuplicate" Style="{StaticResource MenuIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Settings" Tag="Settings" Click="Navigation_Click" />
                </Menu>

                <!-- Project tabs -->
                <ScrollViewer Grid.Column="2"
                              Margin="14,0,10,0"
                              VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="1" Height="18" Margin="0,0,12,0" Background="{DynamicResource DividerBrush}" />
                        <ItemsControl ItemsSource="{Binding Source={x:Static app:MainWindow.ProjectSessions}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProjectTabButton}"
                                            Margin="0,0,4,0"
                                            ToolTip="{Binding Title}"
                                            AutomationProperties.Name="{Binding Title}"
                                            Click="ProjectTab_Click"
                                            MouseUp="ProjectTab_MouseUp">
                                        <StackPanel Orientation="Horizontal">
                                            <icons:MaterialIcon Kind="Home"
                                                                Width="14" Height="14"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding HasProject, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            <Ellipse Width="6" Height="6"
                                                     Margin="0,0,7,0"
                                                     Fill="{DynamicResource AccentBrush}"
                                                     ToolTip="Unsaved changes"
                                                     Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       MaxWidth="170"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{StaticResource TabCloseButton}"
                                                    Margin="6,0,0,0"
                                                    ToolTip="Close (Ctrl+W)"
                                                    AutomationProperties.Name="Close tab"
                                                    Click="CloseProjectTab_Click" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource IconButton}"
                                Width="28" Height="28"
                                ToolTip="New tab (Ctrl+T)"
                                AutomationProperties.Name="New tab"
                                Click="NewTab_Click">
                            <icons:MaterialIcon Kind="Plus" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Column="3"
                           Text="{Binding AppVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource SidebarBrush}"
                   BorderBrush="{DynamicResource DividerBrush}"
                   BorderThickness="0,1,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Height="28"
                   Padding="6,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" MouseDoubleClick="StatusBarItem_MouseDoubleClick" ToolTip="Double-click to open logs">
                <StackPanel Orientation="Horizontal">
                    <controls:AutoSaveIndicator x:Name="AutoSaveIndicator" Visibility="Collapsed" Margin="0,0,6,0" />
                    <icons:MaterialIcon x:Name="logBarIcon" Visibility="Hidden" Width="14" Height="14" HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Name="logBar" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Padding="6,0,0,0"></TextBlock>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right" Padding="8,0">
                <TextBlock FontSize="12">
                    <Hyperlink Style="{StaticResource FooterLink}" NavigateUri="{x:Static constants:GlobalConstants.DISCORD_INVITE_URL}" RequestNavigate="Hyperlink_RequestNavigate">Discord</Hyperlink>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" HorizontalAlignment="Right" Padding="8,0">
                <TextBlock FontSize="12">
                    <Hyperlink Style="{StaticResource FooterLink}" NavigateUri="https://github.com/grzybeek/grzyClothTool" RequestNavigate="Hyperlink_RequestNavigate">Source code</Hyperlink>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3" HorizontalAlignment="Right" Padding="8,0,4,0">
                <TextBlock FontSize="12">
                    <Hyperlink Style="{StaticResource FooterLink}" NavigateUri="https://patreon.com/grzybeek" RequestNavigate="Hyperlink_RequestNavigate">Support me!</Hyperlink>
                </TextBlock>
            </StatusBarItem>

            <StatusBarItem Grid.ColumnSpan="4" Padding="0" VerticalAlignment="Top">
                <ProgressBar x:Name="progressBar"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource AccentBrush}"
                             Height="2"
                             Visibility="Hidden"
                             IsIndeterminate="True"
                             Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StatusBarItem}}" />
            </StatusBarItem>
        </StatusBar>

        <ad:DockingManager x:Name="DockManager" AllowMixedOrientation="True" Background="{DynamicResource CanvasBrush}">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">

                    <ad:LayoutDocumentPane DockWidth="*" ShowHeader="False">
                        <ad:LayoutDocument
                            ContentId="MainContent"
                            Title="">

                            <ContentControl x:Name="MainWindowContentControl" Content="{Binding CurrentPage}" />
                        </ad:LayoutDocument>
                    </ad:LayoutDocumentPane>

                    <ad:LayoutAnchorablePane DockWidth="500">
                        <ad:LayoutAnchorable
                            x:Name="PreviewAnchorable"
                            ContentId="PreviewAnchorable"
                            Title="3D Preview"
                            CanClose="True"
                            CanHide="True"
                            CanFloat="True"
                            AutoHideWidth="500"
                            FloatingWidth="800"
                            FloatingHeight="600"
                            IsVisible="False">

                            <controls:PreviewWindowHost x:Name="PreviewHost" />
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
