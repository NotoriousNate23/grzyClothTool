<UserControl x:Class="grzyClothTool.Views.ProjectWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:local="clr-namespace:grzyClothTool.Views"
xmlns:c="clr-namespace:grzyClothTool.Controls"
xmlns:m="clr-namespace:grzyClothTool.Models"
xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
d:DataContext="{d:DesignInstance Type=m:AddonManagerDesign, IsDesignTimeCreatable=True}"
Background="{DynamicResource CanvasBrush}"
d:Width="1200"
d:Height="600"
d:Background="white"
mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Addon switcher: segmented pills -->
        <Style x:Key="AddonTabItem" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4"
                                Margin="0,0,2,2"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="TabText"
                                       Text="{Binding Name}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddMenuIcon" TargetType="icons:MaterialIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <ContextMenu x:Key="AddMaleMenu">
            <MenuItem Header="Male components…" Click="Add_MaleComponents">
                <MenuItem.Icon><icons:MaterialIcon Kind="TshirtCrew" Style="{StaticResource AddMenuIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Male props…" Click="Add_MaleProps">
                <MenuItem.Icon><icons:MaterialIcon Kind="HatFedora" Style="{StaticResource AddMenuIcon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Male folder…" Click="Add_DrawableMaleFolder">
                <MenuItem.Icon><icons:MaterialIcon Kind="FolderOutline" Style="{StaticResource AddMenuIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Auto-detect folder…" Click="Add_DrawableAutoFolder" />
        </ContextMenu>

        <ContextMenu x:Key="AddFemaleMenu">
            <MenuItem Header="Female components…" Click="Add_FemaleComponents">
                <MenuItem.Icon><icons:MaterialIcon Kind="TshirtCrew" Style="{StaticResource AddMenuIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Female props…" Click="Add_FemaleProps">
                <MenuItem.Icon><icons:MaterialIcon Kind="HatFedora" Style="{StaticResource AddMenuIcon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Female folder…" Click="Add_DrawableFemaleFolder">
                <MenuItem.Icon><icons:MaterialIcon Kind="FolderOutline" Style="{StaticResource AddMenuIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Auto-detect folder…" Click="Add_DrawableAutoFolder" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" MinWidth="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Toolbar ============ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource CanvasBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectName, Mode=OneWay}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420" />
                    <Border Style="{StaticResource PillBorder}" Margin="10,0,0,0">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding Addons.Count, Mode=OneWay}" /><Run Text=" addon(s)" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <c:CustomButton x:Name="PreviewButton"
                                    Label="3D Preview"
                                    Image="Rotate3dVariant"
                                    Height="34"
                                    MinWidth="128"
                                    Tooltip="Open the live 3D previewer"
                                    MyBtnClickEvent="Preview_Btn"
                                    Margin="0,0,8,0" />
                    <c:CustomButton Label="Build"
                                    Image="Hammer"
                                    Variant="Primary"
                                    Height="34"
                                    MinWidth="128"
                                    Tooltip="Build resource for FiveM, alt:V or singleplayer"
                                    MyBtnClickEvent="BuildResource_Btn" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Sidebar: drawables ============ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar header -->
                <TextBlock Grid.Row="0"
                           Text="Drawables"
                           Margin="14,14,12,10"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TabControl x:Name="AddonTabControl"
                            Grid.Row="1"
                            ItemsSource="{Binding Addons}"
                            SelectedIndex="0"
                            SelectedItem="{Binding SelectedAddon}"
                            SelectionChanged="TabControl_SelectionChanged"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource AddonTabItem}" />
                    </TabControl.ItemContainerStyle>
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource SegmentedTrack}"
                                        Margin="12,0,12,8"
                                        Padding="3,3,1,1"
                                        HorizontalAlignment="Left">
                                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                                </Border>

                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid AllowDrop="True"
                                  Drop="DrawablesGroupBox_Drop"
                                  DragEnter="DrawablesGroupBox_DragEnter"
                                  DragOver="DrawablesGroupBox_DragOver"
                                  DragLeave="DrawablesGroupBox_DragLeave"
                                  Background="Transparent">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Search -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource ControlBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Height="32"
                                        Margin="12,0,12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <icons:MaterialIcon Grid.Column="0"
                                                            Kind="Magnify"
                                                            Width="15"
                                                            Height="15"
                                                            Foreground="{DynamicResource TextTertiaryBrush}"
                                                            Margin="9,0,4,0"
                                                            VerticalAlignment="Center" />
                                        <TextBox x:Name="HeaderSearchBox"
                                                 Grid.Column="1"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 Padding="0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Search drawables"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=HeaderSearchBox, FallbackValue=0}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="2"
                                                Style="{StaticResource PillBorder}"
                                                Margin="4,0,6,0"
                                                Padding="7,1">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding FilteredCount, ElementName=DrawableListControl}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text.Length, ElementName=HeaderSearchBox, FallbackValue=0}" Value="0">
                                                                <Setter Property="Text" Value="{Binding Drawables.Count}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Padding="8,0,4,8">
                                    <c:DrawableList x:Name="DrawableListControl"
                                                    ItemsSource="{Binding Drawables, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    SearchText="{Binding Text, ElementName=HeaderSearchBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    DrawableListKeyDown="SelectedDrawable_KeyDown"
                                                    DrawableListSelectedValueChanged="SelectedDrawable_Changed"
                                                    DrawableDeleteRequested="DrawableList_DeleteRequested" />
                                </Border>

                                <!-- Empty state (does not block drag & drop) -->
                                <StackPanel Grid.Row="1"
                                            IsHitTestVisible="False"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="24">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Drawables.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Center">
                                        <icons:MaterialIcon Kind="TshirtCrew" Width="26" Height="26" Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                    <TextBlock Text="Drop .ydd files here"
                                               Margin="0,14,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="or use Add Male / Add Female below."
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Bottom action bar (DurtyCloth-style): Add Male / Add Female.
                     Type & component/prop are detected from file names; right-click for more. -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Height="36"
                                AutomationProperties.Name="Add Male"
                                AutomationProperties.AutomationId="ADD MALE"
                                ToolTip="Add male drawables (.ydd). Right-click for components, props or a folder."
                                ContextMenu="{StaticResource AddMaleMenu}"
                                Click="Add_MaleClick">
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon Kind="HumanMale" Width="17" Height="17" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Add Male" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Height="36"
                                AutomationProperties.Name="Add Female"
                                AutomationProperties.AutomationId="ADD FEMALE"
                                ToolTip="Add female drawables (.ydd). Right-click for components, props or a folder."
                                ContextMenu="{StaticResource AddFemaleMenu}"
                                Click="Add_FemaleClick">
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon Kind="HumanFemale" Width="17" Height="17" Margin="0,0,6,0" Foreground="{DynamicResource PropBrush}" />
                                <TextBlock Text="Add Female" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Width="36" Height="36"
                                Margin="8,0,0,0"
                                ToolTip="Delete selected (Del)"
                                AutomationProperties.Name="Delete selected drawable"
                                Click="Delete_SelectedDrawable">
                            <icons:MaterialIcon Kind="TrashCanOutline" Width="17" Height="17" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Editor ============ -->
        <Grid Grid.Row="1" Grid.Column="1">
            <c:SelectedDrawable x:Name="SelDrawable"
                                TextureListSelectedValueChanged="SelectedDrawable_TextureChanged"
                                SelectedDrawableUpdated="SelectedDrawable_Updated"
                                SelectedDraw="{Binding SelectedAddon.SelectedDrawable}"
                                SelectedTxt="{Binding SelectedAddon.SelectedTexture}" />
        </Grid>
    </Grid>
</UserControl>
