<Window x:Class="grzyClothTool.Views.DurtyClothImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="Import from DurtyCloth"
        Width="760" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Import from DurtyCloth" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Padding="10,4" Content="Select all" Click="SelectAll_Click" />
                <Button Style="{StaticResource GhostButton}" Padding="10,4" Content="Select none" Click="SelectNone_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4">
            <ListBox x:Name="ProjectList"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,8" Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding ShowGenderChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Unknown gender:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <ComboBox Width="92" SelectedItem="{Binding FallbackGender, Mode=TwoWay}" ItemsSource="{Binding GenderOptions}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <CheckBox x:Name="CopyFilesCheck" Grid.Row="3" Margin="2,14,0,0" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Copy files into the Nightfall project" FontWeight="SemiBold" />
                <Run Text=" - keeps working if DurtyCloth's folders are moved or deleted (uses extra disk space)." Foreground="{DynamicResource TextSecondaryBrush}" />
            </TextBlock>
        </CheckBox>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" FontSize="11.5"
                       Text="More than 4 projects are saved to your projects folder instead of opening as tabs." />
            <Button Grid.Column="1" Content="Cancel" Margin="12,0,8,0" MinWidth="90" Click="Cancel_Click" IsCancel="True" />
            <Button x:Name="ImportButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="Import_Click" IsDefault="True">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon Kind="FileImportOutline" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock x:Name="ImportButtonText" Text="Import" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
