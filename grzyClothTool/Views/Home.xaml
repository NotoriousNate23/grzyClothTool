<UserControl x:Class="grzyClothTool.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:grzyClothTool.Views"
             xmlns:c="clr-namespace:grzyClothTool.Controls"
             xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             d:Background="white"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource CanvasBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <!-- Row-style list button (recent projects, tools) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoveRecentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Remove from recents" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                            <icons:MaterialIcon x:Name="CloseIcon" Kind="Close" Width="14" Height="14" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                                <Setter TargetName="CloseIcon" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetaPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1180" Margin="48,36,48,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="grzyClothTool" Style="{StaticResource TitleText}" />
                    <TextBlock Text="Build and manage GTA V addon clothing packs."
                               Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <c:CustomButton Grid.Column="1"
                                Label="Close"
                                Variant="Ghost"
                                Height="34"
                                VerticalAlignment="Top"
                                MyBtnClickEvent="Close_Click" />
            </Grid>

            <!-- Start + Recent -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="START" Style="{StaticResource SectionLabel}" />

                    <c:CustomButton Label="Create new project"
                                    AutomationProperties.AutomationId="Create new project"
                                    Image="Plus"
                                    Variant="Primary"
                                    Height="44"
                                    FontSize="14"
                                    MyBtnClickEvent="CreateNew_Click" />

                    <c:CustomButton Label="Import project"
                                    Image="FileImportOutline"
                                    Height="38"
                                    Margin="0,10,0,0"
                                    MyBtnClickEvent="ImportProject_Click" />
                    <c:CustomButton Label="Open addon"
                                    Image="FolderOpenOutline"
                                    Height="38"
                                    Margin="0,8,0,0"
                                    MyBtnClickEvent="OpenAddon_Click" />
                    <c:CustomButton Label="Open save"
                                    Image="ContentSave"
                                    Height="38"
                                    Margin="0,8,0,0"
                                    MyBtnClickEvent="OpenSave_Click" />

                    <Border Style="{StaticResource CardBorder}" Margin="0,24,0,0" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <icons:MaterialIcon Kind="LightbulbOn"
                                                Width="16" Height="16"
                                                VerticalAlignment="Top"
                                                Margin="0,1,10,0"
                                                Foreground="{DynamicResource WarningBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Did you know?" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding RandomDidYouKnow}"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource SecondaryText}"
                                           LineHeight="18" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="RECENT" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource CardBorder}" Padding="6" MinHeight="250">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                <ItemsControl ItemsSource="{Binding RecentlyOpened}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}"
                                                    Click="RecentProject_Click"
                                                    Tag="{Binding FilePath}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="36" Height="36"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource AccentSubtleBrush}"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Center">
                                                        <icons:MaterialIcon Kind="FolderOutline" Width="18" Height="18" Foreground="{DynamicResource AccentTextBrush}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ProjectName}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="11"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Self-contained"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                                                                <Setter Property="Text" Value="External"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding AddonCount, Mode=OneWay}"/><Run Text=" addons  ·  "/><Run Text="{Binding DrawableCount, Mode=OneWay}"/><Run Text=" drawables  ·  "/><Run Text="{Binding LastModified, Mode=OneWay, StringFormat='{}{0:MMM d, yyyy  HH:mm}'}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource RemoveRecentButton}"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0"
                                                            Click="RemoveRecentProject_Click"
                                                            Tag="{Binding FilePath}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="20"
                                        Visibility="{Binding ShowNoRecentProjects, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <icons:MaterialIcon Kind="FolderOpenOutline"
                                                    Width="40"
                                                    Height="40"
                                                    Foreground="{DynamicResource TextTertiaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,10"/>
                                <TextBlock Text="No recent projects"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Projects you open will appear here."
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- What's new / Tools / Supporters -->
            <Grid Grid.Row="2" Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="0.7*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="WHAT'S NEW" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource CardBorder}" Height="250">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="Version " /><Run Text="{Binding LatestVersion, Mode=OneWay}" />
                            </TextBlock>
                            <c:CustomButton DockPanel.Dock="Bottom"
                                            Label="Full changelog on GitHub"
                                            Variant="Ghost"
                                            Height="32"
                                            HorizontalAlignment="Left"
                                            Margin="-10,6,0,-6"
                                            MyBtnClickEvent="ViewChangelog_Click" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ChangelogHighlights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,7,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource SecondaryText}" LineHeight="18" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="MORE TOOLS" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource CardBorder}" Height="250" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OtherTools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}"
                                                CommandParameter="{Binding Url}"
                                                Click="OpenToolUrl_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource HoverBrush}"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Top">
                                                    <icons:MaterialIcon Kind="Tools" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Margin="0,2,0,0"
                                                               MaxHeight="36"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource SecondaryText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <DockPanel Grid.Column="4">
                    <TextBlock DockPanel.Dock="Top" Text="SUPPORTERS" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource CardBorder}" Height="250" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PatreonList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MetaPill}" Margin="0,0,6,6" Padding="8,3">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
